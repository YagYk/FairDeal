# FAIRDEAL environment configuration
# -----------------------------------
# Copy this file to `.env` (same directory as this file) and fill in the
# values you actually have. The backend reads it through pydantic-settings,
# so anything left blank simply falls back to the in-code defaults.
#
# `.env` is git-ignored on purpose: never commit your real key.

# ---------- LLM (Google Gemini) ----------
# Required if you want:
#   - Gemini Vision OCR for scanned PDFs
#   - Sniper extraction for fields the regex layer misses
#   - AI-narrated verdicts on the Results page
# Without a key the backend stays in fully deterministic mode and the rest
# of the pipeline keeps working unchanged.
FAIRDEAL_LLM_API_KEY=

# Optional — override the default model. Leave blank for the default.
# FAIRDEAL_LLM_MODEL=gemini-1.5-pro

# ---------- Server behaviour ----------
# Set to `true` only when actively debugging.
FAIRDEAL_DEBUG=false
